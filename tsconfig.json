{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@template/*": [
        "participants/template/*"
      ],
      "@phuctien1909/*": [
        "participants/phuctien1909/*"
      ]
    }
  },
  "include": [
    "playwright.config.ts",
    "participants/**/*",
  ]
}