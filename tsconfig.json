{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@template/*": ["participants/template/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "playwright.config.ts", "participants/**/*", "participants/template/**/*"]
}
